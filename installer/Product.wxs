<?xml version="1.0" encoding="UTF-8"?>
<!--
  dualsense-xbridge installer (WiX v3)

  Build:
    candle Product.wxs -out Product.wixobj
    light  Product.wixobj -ext WixUtilExtension -out DualSenseXBridge.msi

  Product GUID stays stable across versions; Upgrade element forces in-place
  upgrade when this MSI's version is higher than the installed one.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Product Id="4a094268-44d7-408c-a2fa-f565bf9efcd1"
           Name="DualSense XBridge"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="Baker Engineering"
           UpgradeCode="9c6cbd2e-b1f4-4398-b2ec-1559e800c7fc">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="DualSense -> ViGEm X360 bridge" />

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- ====================================================================
         Directory layout: %ProgramFiles%\BakerEngineering\DualSenseXBridge\
         ==================================================================== -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="PUBLISHER_DIR" Name="BakerEngineering">
          <Directory Id="INSTALLFOLDER" Name="DualSense-Bridge">

            <Component Id="BridgeScript" Guid="3bfa3f49-7f54-44c0-b9cc-c1137497010f" Win64="yes">
              <File Id="BridgePs1"
                    Source="..\src\bridge.ps1"
                    KeyPath="yes" />
            </Component>

            <Component Id="VigemClientDll" Guid="bceaa9d9-20da-49cf-9be0-e917fc87ef50" Win64="yes">
              <File Id="VigemClientDllFile"
                    Source="..\src\vigemclient.dll"
                    KeyPath="yes" />
            </Component>

            <Component Id="TaskInstallScript" Guid="71ad4c27-4f73-479d-b697-c6360fd8affa" Win64="yes">
              <File Id="InstallTaskPs1"
                    Source="install-task.ps1"
                    KeyPath="yes" />
            </Component>

            <Component Id="TaskUninstallScript" Guid="1ccf7433-5c95-4a14-b334-5600937e8d08" Win64="yes">
              <File Id="UninstallTaskPs1"
                    Source="uninstall-task.ps1"
                    KeyPath="yes" />
            </Component>

            <Component Id="TaskXml" Guid="8f373892-bbfb-4f6f-8262-cd8c9f7686f8" Win64="yes">
              <File Id="BridgeTaskXml"
                    Source="bridge-task.xml"
                    KeyPath="yes" />
            </Component>

          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="DualSense XBridge" Level="1">
      <ComponentRef Id="BridgeScript" />
      <ComponentRef Id="VigemClientDll" />
      <ComponentRef Id="TaskInstallScript" />
      <ComponentRef Id="TaskUninstallScript" />
      <ComponentRef Id="TaskXml" />
    </Feature>

    <!-- ====================================================================
         Custom actions:
           On install   -> install-task.ps1 (registers DualSenseXBridge schtask)
           On uninstall -> uninstall-task.ps1 (removes schtask, kills running bridge)
         ==================================================================== -->
    <Property Id="POWERSHELLEXE">
      <RegistrySearch Id="POWERSHELLEXE"
                      Type="raw"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\PowerShell\1\ShellIds\Microsoft.PowerShell"
                      Name="Path" />
    </Property>

    <CustomAction Id="RegisterTask"
                  Property="POWERSHELLEXE"
                  ExeCommand='-NoProfile -ExecutionPolicy Bypass -File "[INSTALLFOLDER]install-task.ps1" -InstallFolder "[INSTALLFOLDER]"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <CustomAction Id="UnregisterTask"
                  Property="POWERSHELLEXE"
                  ExeCommand='-NoProfile -ExecutionPolicy Bypass -File "[INSTALLFOLDER]uninstall-task.ps1"'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="RegisterTask" After="InstallFiles">NOT Installed AND NOT REMOVE</Custom>
      <Custom Action="UnregisterTask" Before="RemoveFiles">Installed AND REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
